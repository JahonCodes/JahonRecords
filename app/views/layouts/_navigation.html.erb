
<%# 

Navigation tutorial: 
Create a Responsive Tailwind Navbar with Dropdowns
https://www.youtube.com/watch?v=h_xmLBxS5SA&ab_channel=webcrunch

%>

<%= javascript_include_tag('navigation.js') %>

<nav class="text-black">
    <div class="container mx-auto px-4 md:flex items-center gap-6">
        <div class="flex items-center justify-between md:w-auto w-full">
            <%= link_to root_path, class: "block leading-none" do %>
                <%= image_tag "jr_cropped.png", alt: "JahonRecords", class: "block h-10 w-auto py-2" %>
            <% end %>

            <%# Mobile menu icon %>
            <div class="md:hidden flex items-center">
                <button type="button" class="mobile-menu-button">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M12 17.25h8.25" />
                    </svg>
                </button>
            </div>
        </div>

        <div class="hidden md:flex md:flex-row flex-col items-center justify-start md:space-x-1 pb-3 md:pb-0 navigation-menu ml-auto">
            <%= link_to "Home", root_path, class: "py-2 px-3 block mx-auto hover:bg-red-200" %>
            <%= link_to "Projects", projects_path, class: "py-2 px-3 block mx-auto hover:bg-red-200" %>

            <% if user_signed_in? %>
                <%= link_to "Log out", destroy_user_session_path, class: "py-2 px-3 block mx-auto hover:bg-red-200", data: { turbo_method: :delete }  %>
            <% end %>
        </div> 
    </div>

</nav>

<%= render 'layouts/navigation' %>

<div class="container mx-auto px-4 py-12">
  <div class="max-w-6xl mx-auto">
    <!-- Header Section -->
    <div class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-3">Projects</h1>
      <p class="text-lg text-gray-600">A selection of work demonstrating full-stack development, mobile engineering, and infrastructure expertise.</p>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <% @projects.each do |project| %>
        <div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:shadow-md transition-shadow duration-200">
          <!-- Project Header -->
          <div class="p-6 border-b border-gray-100">
            <h2 class="text-2xl font-semibold text-gray-900 mb-1">
              <% if project[:link] %>
                <a href="<%= project[:link] %>" target="_blank" rel="noopener noreferrer" class="hover:text-blue-600 transition-colors">
                  <%= project[:title] %>
                  <svg class="inline-block w-5 h-5 ml-1 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                </a>
              <% else %>
                <%= project[:title] %>
              <% end %>
            </h2>
            <p class="text-sm font-medium text-gray-500"><%= project[:subtitle] %></p>
          </div>

          <!-- Project Content -->
          <div class="p-6">
            <!-- Description -->
            <p class="text-gray-700 mb-6 leading-relaxed"><%= project[:description] %></p>

            <!-- Objectives -->
            <div class="mb-6">
              <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-3">Key Objectives</h3>
              <ul class="space-y-2">
                <% project[:objectives].each do |objective| %>
                  <li class="flex items-start">
                    <svg class="w-5 h-5 text-green-500 mr-2 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    <span class="text-sm text-gray-700"><%= objective %></span>
                  </li>
                <% end %>
              </ul>
            </div>

            <!-- Technologies -->
            <div>
              <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-3">Technologies</h3>
              <div class="flex flex-wrap gap-2">
                <% project[:technologies].each do |tech| %>
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    <%= tech %>
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

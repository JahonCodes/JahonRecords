<%= render 'layouts/navigation' %>

<div class="min-h-screen bg-slate-50">
  <div class="max-w-4xl mx-auto px-12 sm:px-16 lg:px-20 xl:px-24 py-20">
    <!-- Header -->
    <div class="text-center mb-24">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-white rounded-2xl shadow-lg mb-8">
        <%= image_tag "unblurred-icon.png", alt: "Unblurred", class: "w-10 h-10" %>
      </div>
      <h1 class="text-5xl font-bold text-slate-900 mb-6">Unblurred Support</h1>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        A simple app to organize your thoughts and stay focused on what matters.
      </p>
    </div>

    <!-- Contact Section -->
    <div class="bg-white rounded-3xl shadow-xl p-12 mb-24">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Get Help</h2>
        <p class="text-lg text-slate-600">We're here to help you get the most out of Unblurred</p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <h3 class="font-semibold text-slate-900 mb-2">Email Support</h3>
          <a href="mailto:hello@thejrstudio.com" class="text-blue-600 hover:text-blue-700 font-medium">
            hello@thejrstudio.com
          </a>
        </div>
        
        <div class="text-center">
          <h3 class="font-semibold text-slate-900 mb-2">Response Time</h3>
          <p class="text-slate-600 font-medium">24-48 hours</p>
        </div>
        
        <div class="text-center">
          <h3 class="font-semibold text-slate-900 mb-2">Developer</h3>
          <p class="text-slate-600 font-medium">JR Studio</p>
        </div>
      </div>
    </div>

    <!-- Features & Help -->
    <div class="grid lg:grid-cols-2 gap-10 mb-24">
      <!-- Quick Start -->
      <div class="bg-white rounded-3xl shadow-xl p-12">
        <div class="mb-10">
          <h2 class="text-2xl font-bold text-slate-900">Quick Start</h2>
        </div>
        
        <div class="space-y-8">
          <div>
            <h3 class="font-semibold text-slate-900 mb-1">1. Set Daily Priorities</h3>
            <p class="text-slate-600 text-sm">Choose your most important tasks for the day</p>
          </div>
          
          <div>
            <h3 class="font-semibold text-slate-900 mb-1">2. Organize by Projects</h3>
            <p class="text-slate-600 text-sm">Group tasks into projects and goals</p>
          </div>
          
          <div>
            <h3 class="font-semibold text-slate-900 mb-1">3. Use Voice Input</h3>
            <p class="text-slate-600 text-sm">Record thoughts quickly with voice-to-text</p>
          </div>
          
          <div>
            <h3 class="font-semibold text-slate-900 mb-1">4. Focus Timer</h3>
            <p class="text-slate-600 text-sm">Stay focused with built-in timer sessions</p>
          </div>
        </div>
      </div>

      <!-- Privacy & Security -->
      <div class="bg-white rounded-3xl shadow-xl p-12">
        <div class="mb-10">
          <h2 class="text-2xl font-bold text-slate-900">Privacy & Security</h2>
        </div>
        
        <div class="space-y-6">
          <div class="flex items-center space-x-3">
            <span class="text-green-600 font-bold">✓</span>
            <p class="text-slate-600">All data stored locally on your device</p>
          </div>
          
          <div class="flex items-center space-x-3">
            <span class="text-green-600 font-bold">✓</span>
            <p class="text-slate-600">No data shared with third parties</p>
          </div>
          
          <div class="flex items-center space-x-3">
            <span class="text-green-600 font-bold">✓</span>
            <p class="text-slate-600">No account required</p>
          </div>
          
          <div class="flex items-center space-x-3">
            <span class="text-green-600 font-bold">✓</span>
            <p class="text-slate-600">No analytics or tracking</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Troubleshooting -->
    <div class="bg-white rounded-3xl shadow-xl p-12 mb-24">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Troubleshooting</h2>
        <p class="text-lg text-slate-600">Common issues and quick solutions</p>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-gradient-to-br from-red-50 to-red-100 rounded-2xl p-6 border border-red-200">
          <h3 class="font-bold text-slate-900 text-lg mb-4">Voice Input Issues</h3>
          <p class="text-slate-700 mb-3">Check microphone permissions in Settings > Privacy & Security > Microphone</p>
          <div class="text-sm text-slate-600">
            <p>• Ensure you're in a quiet environment</p>
            <p>• Try speaking clearly and at normal volume</p>
            <p>• Restart the app if issues persist</p>
          </div>
        </div>
        
        <div class="bg-gradient-to-br from-yellow-50 to-yellow-100 rounded-2xl p-6 border border-yellow-200">
          <h3 class="font-bold text-slate-900 text-lg mb-4">App Crashes</h3>
          <p class="text-slate-700 mb-3">Force-close and reopen the app, or restart your device</p>
          <div class="text-sm text-slate-600">
            <p>• Make sure you have the latest app version</p>
            <p>• Check that your device meets iOS 13.0+ requirement</p>
            <p>• Free up storage space if needed</p>
          </div>
        </div>
        
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl p-6 border border-blue-200">
          <h3 class="font-bold text-slate-900 text-lg mb-4">Timer Problems</h3>
          <p class="text-slate-700 mb-3">Make sure you've selected a valid duration and try restarting the timer</p>
          <div class="text-sm text-slate-600">
            <p>• Check that the app isn't in background too long</p>
            <p>• Try selecting a different time duration</p>
            <p>• Restart the focus session</p>
          </div>
        </div>
        
        <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-2xl p-6 border border-green-200">
          <h3 class="font-bold text-slate-900 text-lg mb-4">Data Not Saving</h3>
          <p class="text-slate-700 mb-3">Check device storage space and try force-closing the app</p>
          <div class="text-sm text-slate-600">
            <p>• Ensure you have enough storage space</p>
            <p>• Check that you're entering valid text</p>
            <p>• Try force-closing and reopening the app</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="text-center py-12">
      <div class="inline-flex items-center space-x-8 mb-6">
        <a href="/unblurred-privacy" class="text-slate-500 hover:text-slate-700 transition-colors font-medium">
          Privacy Policy
        </a>
        <a href="https://thejrstudio.com/terms" class="text-slate-500 hover:text-slate-700 transition-colors font-medium">
          Terms of Service
        </a>
      </div>
      <p class="text-slate-400 text-sm">
        © <%= Date.current.year %> JR Studio. All rights reserved.
      </p>
      <p class="text-slate-300 text-xs mt-2">
        Unblurred - Focus on what matters
      </p>
    </div>
  </div>
</div>

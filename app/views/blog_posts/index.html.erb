<%= render 'layouts/navigation' %>

<%= javascript_include_tag('navigation.js') %>

<div class="container mx-auto px-4">
    <% @blog_posts.each do |blog_post| %>
        <div class="py-2">
            <h2>
                <%= link_to blog_post.title, blog_post %>
            </h2>
            <p><%= blog_post.body %></p>
        </div>
    <% end %>
</div>
